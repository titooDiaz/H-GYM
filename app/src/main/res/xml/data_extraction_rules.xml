<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="h_gym_db"/>
        <exclude domain="database" path="h_gym_db-shm"/>
        <exclude domain="database" path="h_gym_db-wal"/>
        <exclude domain="file" path="meal_photos"/>
        <exclude domain="file" path="evolution_photos"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="h_gym_db"/>
        <include domain="file" path="meal_photos"/>
    </device-transfer>
</data-extraction-rules>
